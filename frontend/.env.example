# Optional override for the backend base URL.
# Read by src/config.ts as VITE_API_BASE (not VITE_API_URL).
# Unset, the app uses http://localhost:8000 in dev and the Railway
# deployment in a production build.
# VITE_API_BASE=https://your-backend-url.railway.app


# ---------------------------------------------------------------------------
# Tip jar
# ---------------------------------------------------------------------------
# Set ONE of the two below. With neither set, every donate surface renders
# nothing — no dead button, no link to a 404.
#
# Ko-fi's free plan takes 0% of one-time tips; you pay only the Stripe/PayPal
# processing fee, and the money lands in your own account. Ko-fi Gold (~$6/mo)
# is for branding and shop fees — not needed for a tip jar.
#
# Username only, not the full URL — the app builds https://ko-fi.com/<name>
# VITE_KOFI_USERNAME=yourname

# Or point anywhere else: a Stripe Payment Link, Buy Me a Coffee, GitHub
# Sponsors, PayPal.me. Takes precedence over VITE_KOFI_USERNAME.
# VITE_DONATE_URL=https://buy.stripe.com/xxxxxxxx


# ---------------------------------------------------------------------------
# Analytics
# ---------------------------------------------------------------------------
# Google Analytics 4 measurement ID. Unset means no script is injected, no
# cookie is set and no request is made — which is what keeps local development
# and Vercel preview builds out of the numbers.
#
# Use a SEPARATE property from lilbeats. Two products in one property gives you
# a blended funnel that describes neither.
# VITE_GA_ID=G-XXXXXXXXXX
