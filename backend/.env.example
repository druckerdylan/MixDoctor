# Required for the AI engineer write-up. Without it the analysis still runs and
# every finding is measured — only the prose is skipped.
# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# Optional: signing key for auth tokens. Read by auth.py as JWT_SECRET_KEY.
# Falls back to an insecure dev default — set a real random string in production.
JWT_SECRET_KEY=your_jwt_secret_here

# Optional: database URL (defaults to sqlite:///./mixdoctor.db)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# The AI write-up. OFF by default, deliberately.
#
# Every /engineer call costs the operator roughly $0.40 of Anthropic credit,
# uncapped and unauthenticated — so on a public deployment the default of "on"
# bills you for every visitor and every refresh. Set to 1 only on a private
# instance, or once there is a way to charge for it.
#
# With it off, nothing breaks: measured findings, all 51 explainers, the
# clarification questions, the score card and the downloadable report are all
# deterministic. /engineer returns 503 and the UI says the write-up is switched
# off on this server.
# MIXDOCTOR_RUN_AI=0

# Hard ceiling on AI spend, in USD. Only consulted when MIXDOCTOR_RUN_AI=1.
#
# The check runs BEFORE the API call and reserves the cost of a typical report,
# so the cap cannot be stepped over on its last call. Spend is recorded in the
# database, so it survives a restart and is shared across workers — an
# in-memory counter would reset on every deploy.
#
# 0 (the default) means the layer will not run even with MIXDOCTOR_RUN_AI=1.
# At roughly $0.40 a report, $5 is about a dozen. Once it is spent, /engineer
# returns 503 and users get the free report until the window rolls over.
#
# This is not a substitute for the spend limit in the Anthropic console. Set
# that too — it catches anything that never reaches our own bookkeeping.
# MIXDOCTOR_AI_BUDGET_USD=5.00
# MIXDOCTOR_AI_BUDGET_PERIOD=day        # day | month

# Optional: DSP thread-pool size (default: min(3, cpu_count)).
# MIXDOCTOR_ANALYSIS_WORKERS=3

# Optional: source separation ("deep analysis"). OFF by default, and both gates
# must pass — this flag AND torch/demucs actually being importable. See
# requirements-stems.txt: they are ~800 MB of image and want a couple of GB of
# RAM per job, so the default deployment ships without them. GET /capabilities
# reports the resolved state and the frontend hides the toggle when it is off.
# MIXDOCTOR_ENABLE_STEMS=0

# Optional: log level (default INFO)
# LOG_LEVEL=INFO
